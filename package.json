{
  "name": "ostrio-cookies",
  "private": true,
  "types": "index.d.ts",
  "scripts": {
    "test:once": "./node_modules/.bin/mtest --package ./ --port=8888 --once",
    "test:watch": "./node_modules/.bin/mtest --package ./ --port=8888",
    "test:browser": "meteor test-packages ./ --port 8888",
    "test:types": "./node_modules/.bin/tsd",
    "test:coverage": "node tests/run-coverage.mjs",
    "test": "npm run test:once && npm run test:types"
  },
  "devDependencies": {
    "@zodern/mtest": "^0.6.0",
    "nyc": "^18.0.0",
    "tsd": "^0.33.0"
  },
  "tsd": {
    "files": [
      "index.test-d.ts"
    ]
  },
  "nyc": {
    "temp-dir": ".coverage",
    "report-dir": "coverage",
    "reporter": [
      "text",
      "html",
      "lcov"
    ],
    "statements": 95,
    "branches": 95,
    "functions": 95,
    "lines": 95
  }
}
